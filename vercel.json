{
  "rewrites": [
    {
      "source": "/brains-that-build",
      "destination": "/brains-that-build.html"
    },
    {
      "source": "/((?!brains-that-build).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/send-reminders",
      "schedule": "0 13 * * *"
    }
  ]
}